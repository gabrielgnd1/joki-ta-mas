# Turso / libSQL database (production)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Local SQLite fallback when TURSO_DATABASE_URL is empty (optional)
# DATABASE_PATH=./data/jokitamas.db

# First admin account, created automatically when the database is empty.
ADMIN_NAME=Admin Jokitamas
ADMIN_EMAIL=admin@jokitamas.local
ADMIN_PASSWORD=ganti-password-ini

# Set to "true" when serving over HTTPS
COOKIE_SECURE=false
